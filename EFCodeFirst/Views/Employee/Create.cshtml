@model EFCodeFirst.Models.Entities.Employee2
@{
    ViewBag.Title = "Create";
}

<h2>Add Employee</h2>

@using (Html.BeginForm())
{
    @Html.LabelFor(m => m.FirstName)
    @Html.TextBoxFor(m => m.FirstName)

    <br />
    <br />

    @Html.LabelFor(m => m.MiddleName)
    @Html.TextBoxFor(m => m.MiddleName)

    <br />
    <br />

    @Html.LabelFor(m => m.LastName)
    @Html.TextBoxFor(m => m.LastName)

    <br />
    <br />

    @Html.LabelFor(m => m.DOB)
    @Html.TextBoxFor(m => m.DOB, new { type = "date" })

    <br />
    <br />
    @Html.LabelFor(m => m.MobileNumber)
    @Html.TextBoxFor(m => m.MobileNumber)

    <br />
    <br />

    @Html.LabelFor(m => m.Address)
    @Html.TextBoxFor(m => m.Address)

    <br />
    <br />
    @Html.LabelFor(m => m.Salary)
    @Html.TextBoxFor(m => m.Salary)

    <br />
    <br />

    @Html.Label("Designation")
    @Html.DropDownListFor(m => m.DesignationId, ViewBag.DesignationList as SelectList, "Select Designation", new {@class = "form-control"})

    <br />
    <br />

    <button type="submit">Add Employee</button>
}